{
  "name": "courtside-legacy",
  "version": "0.1.0",
  "private": true,
  "description": "COURTSIDE: LEGACY - simulador de basquete com fisica continua, IA contextual, carreira e franquia.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "sim:game": "npm run build --silent && node dist/src/cli/sim-game.js",
    "sim:season": "npm run build --silent && node dist/src/cli/sim-season.js",
    "sim:tune": "npm run build --silent && node dist/src/cli/tune-report.js",
    "serve": "npm run build --silent && node dist/src/cli/serve.js"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
